# Everything runs with zero env vars. Set these in the morning / on Vercel.
# STORE=json | supabase           (default: supabase if SUPABASE_URL set, else json)
# LLM=anthropic | claude-cli | fixed   (default: anthropic if key set, else claude-cli if on PATH, else fixed)
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Host verification (docs/VERIFICATION.md). Zero env vars = mock verifier, gate off.
# VERIFY_REQUIRED=0 | 1           (default 0; 1 makes monk_comes invites need tier 2, you_go tier 1)
# NEXT_PUBLIC_VERIFY_REQUIRED=0 | 1  (mirror of VERIFY_REQUIRED for the browser; 1 shows "Not verified" badges)
# VERIFY=mock | didit             (default: didit if DIDIT_API_KEY set, else mock)
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# Temple side on LINE (docs/LINE_DRY_RUN.md). Zero env vars = mock LINE + /dev/line.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Bot basic ID, e.g. @123abcde: used in the join message's add-friend and bind links.
LINE_BASIC_ID=
